# 复制为 .env 后填写。本文件不含任何真实密钥。

# ---- QQ 开放平台机器人（必填）----
QQBOT_APP_ID=
QQBOT_SECRET=

# ---- Web 控制台登录（HTTP Basic Auth）----
QQBOT_CONSOLE_USER=admin
QQBOT_CONSOLE_PASSWORD=

# ---- 可选：监听 / 联调 ----
# QQBOT_CONSOLE_HOST=0.0.0.0
# QQBOT_CONSOLE_PORT=8730
# QQBOT_DEV_INGEST=1
# QQBOT_AUTOSTART_BOT=1

# ---- 可选：本地模型 ----
# QQBOT_LLM_PROMPT=tuned
# QQBOT_LLM_PRESCREEN=1
# QQBOT_LLM_WORKERS=1

# ---- 可选：候选反馈 / 推送节奏 ----
# QQBOT_FEEDBACK_RANK=1
# QQBOT_PUSH_COOLDOWN=1800

# ---- 可选：按群词表 ----
# QQBOT_GROUP_LEXICON=./group_lexicon.json
# QQBOT_GROUP_NAMES=./group_names.json
# QQBOT_LEXICON_INTERVAL=300

# ---- 可选：Push Kit（不配则 /health 的 capabilities 不含 push）----
# QQBOT_PUSH_SA=./service_account.json
# QQBOT_PUSH_PROJECT_ID=
# QQBOT_PUSH_CATEGORY=WORK
# QQBOT_PUSH_INCLUDE_TEXT=1
# QQBOT_PUSH_INTERVAL=60

# ---- 可选：中继 ----
# QQBOT_RELAY_KEY=
# QQBOT_RELAY_STORE=./relay_store.json
# QQBOT_PUBLIC_HOST=
# QQBOT_PUBLIC_PORT=
